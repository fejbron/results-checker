# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Never commit .env.local.

# Project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role secret key — SERVER ONLY. Bypasses Row Level Security.
# Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Absolute site URL used to build password-reset links when the
# request headers don't give a reliable origin (e.g. behind some proxies).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
